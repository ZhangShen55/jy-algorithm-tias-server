FROM pytorch/pytorch:2.6.0-cuda11.8-cudnn9-runtime AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /workspace

COPY ./vbas/requirements.txt ./vbas/requirements.txt
RUN pip3 install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
    --timeout 300 \
    --retries 5 \
    --trusted-host mirrors.aliyun.com \
    -r vbas/requirements.txt && \
    pip3 install --no-cache-dir Cython setuptools wheel

COPY ./vbas ./vbas
COPY ./scripts/build_cython_modules.py ./scripts/build_cython_modules.py

RUN python scripts/build_cython_modules.py \
      --root /workspace \
      --package vbas/api \
      --package vbas/core \
      --package vbas/services \
      --package vbas/schemas \
      --keep-source vbas/__init__.py \
      --keep-source vbas/main.py \
      --keep-source vbas/core/__init__.py \
      --keep-source vbas/api/__init__.py \
      --keep-source vbas/services/__init__.py \
      --keep-source vbas/schemas/__init__.py \
      --exclude-glob 'vbas/vendor/**' \
      --exclude-glob 'vbas/models/**' \
      --remove-sources && \
    rm -rf build /workspace/vbas/models /workspace/vbas/models-encrypted && \
    find /workspace/vbas/api /workspace/vbas/core /workspace/vbas/services /workspace/vbas/schemas \
      -type f -name '*.py' ! -name '__init__.py' -delete && \
    find /workspace -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find /workspace/vbas -type f \( -name '*.c' -o -name '*.cpp' \) -delete

FROM pytorch/pytorch:2.6.0-cuda11.8-cudnn9-runtime AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        libfontconfig1 \
        libice6 && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /workspace

COPY --from=builder /opt/conda /opt/conda
COPY --from=builder /workspace/vbas/__init__.py ./vbas/__init__.py
COPY --from=builder /workspace/vbas/main.py ./vbas/main.py
COPY --from=builder /workspace/vbas/api ./vbas/api
COPY --from=builder /workspace/vbas/core ./vbas/core
COPY --from=builder /workspace/vbas/services ./vbas/services
COPY --from=builder /workspace/vbas/schemas ./vbas/schemas
COPY --from=builder /workspace/vbas/vendor/DirectMHP ./vbas/vendor/DirectMHP
COPY ./vbas/docker/secure-entrypoint.sh /usr/local/bin/vbas-secure-entrypoint

RUN chmod 0755 /usr/local/bin/vbas-secure-entrypoint && \
    mkdir -p /workspace/vbas/model-assets /workspace/vbas/models-encrypted && \
    find /workspace/vbas -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find /workspace/vbas -type f \( -name '*.pt' -o -name '*.pth' -o -name '*.onnx' -o -name '*.engine' -o -name '*.key' -o -name '*.pem' -o -name '*.crt' \) -delete

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    CONFIG_PATH=/workspace/vbas/config.toml

EXPOSE 8881 8981 8982

ENTRYPOINT ["/usr/local/bin/vbas-secure-entrypoint"]
CMD ["python", "-m", "uvicorn", "vbas.main:app", "--host", "0.0.0.0", "--port", "8881"]
