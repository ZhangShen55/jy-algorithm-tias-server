FROM pytorch/pytorch:2.6.0-cuda11.8-cudnn9-runtime AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /workspace/vbas

COPY ./requirements.txt ./requirements.txt
RUN pip3 install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
    --timeout 300 \
    --retries 5 \
    --trusted-host mirrors.aliyun.com \
    -r requirements.txt && \
    pip3 install --no-cache-dir Cython setuptools wheel

COPY . .

RUN python scripts/build_cython_modules.py \
      --root /workspace/vbas \
      --package api \
      --package core \
      --package services \
      --package schemas \
      --keep-source __init__.py \
      --keep-source main.py \
      --keep-source core/__init__.py \
      --keep-source api/__init__.py \
      --keep-source services/__init__.py \
      --keep-source schemas/__init__.py \
      --exclude-glob 'models/**' \
      --remove-sources && \
    rm -rf build /workspace/vbas/models /workspace/vbas/models-encrypted && \
    find /workspace/vbas/api /workspace/vbas/core /workspace/vbas/services /workspace/vbas/schemas \
      -type f -name '*.py' ! -name '__init__.py' -delete && \
    find /workspace -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find /workspace/vbas -type f \( -name '*.c' -o -name '*.cpp' \) -delete

FROM pytorch/pytorch:2.6.0-cuda11.8-cudnn9-runtime AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        libfontconfig1 \
        libice6 && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /workspace/vbas

COPY --from=builder /opt/conda /opt/conda
COPY --from=builder /workspace/vbas/__init__.py ./__init__.py
COPY --from=builder /workspace/vbas/main.py ./main.py
COPY --from=builder /workspace/vbas/api ./api
COPY --from=builder /workspace/vbas/core ./core
COPY --from=builder /workspace/vbas/services ./services
COPY --from=builder /workspace/vbas/schemas ./schemas
COPY ./docker/secure-entrypoint.sh /usr/local/bin/vbas-secure-entrypoint

RUN chmod 0755 /usr/local/bin/vbas-secure-entrypoint && \
    mkdir -p /workspace/vbas/models-encrypted && \
    find /workspace/vbas -type d -name '__pycache__' -prune -exec rm -rf {} + && \
    find /workspace/vbas -type f \( -name '*.pt' -o -name '*.pth' -o -name '*.onnx' -o -name '*.engine' -o -name '*.key' -o -name '*.pem' -o -name '*.crt' \) -delete

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    CONFIG_PATH=/workspace/vbas/config.toml

EXPOSE 8881 8981 8982

ENTRYPOINT ["/usr/local/bin/vbas-secure-entrypoint"]
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8881"]
