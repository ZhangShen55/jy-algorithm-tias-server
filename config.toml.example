# 图片根目录。旧同步任务和相对路径图片读取会使用该目录。
IMAGE_ROOT = "/mnt/ias-images"

# 结果图保存配置。SAVE_RESULT_IMAGE=0 表示不额外保存画框结果图。
RESULT_IMAGE_ROOT = "/data/result_images"
SAVE_RESULT_IMAGE = 0

# 服务进程配置。6.0 建议一个 VBAS 实例对应一个端口和一个准入队列。
INSTANCE_COUNT = 1
WORKERS_PER_INSTANCE = 1

# 正式模型只使用 TensorRT FP16；请在本机选择GPU UUID，外层可见性映射将被保留。
GPU_ID = "0"
InferenceBackend = "tensorrt"
InferenceHalf = true
# 空字符串表示项目根目录 model/，不依赖启动cwd。
EngineRoot = ""

[VBAS]
# VBAS 实例身份和对外访问地址。
InstanceId = "vbas-8981"
BaseUrl = "http://127.0.0.1:8981"

# vision_orchestrator 统一入口。多 vision_orchestrator 实例时配置负载均衡地址或服务名。
VisionOrchestratorBaseUrl = "" # 独立验证不向外部服务注册；部署时另行配置

# 是否暴露旧 IAS 同步任务接口。
VbasExposeLegacySyncTasks = false

# 本地推理准入控制。MaxQueueSize=0 表示不开启本地排队，满载直接返回 busy。
MaxConcurrentBatches = 1
MaxQueueSize = 0

# 注册和心跳配置。
HeartbeatIntervalSeconds = 5
HeartbeatTimeoutSeconds = 15
RegisterRetryIntervalSeconds = 5

# HTTP 服务配置。
Host = "0.0.0.0"
Port = 8981

[Person_Thresd]
Head = 0.25
Top_Head = 0.1
Hat = 0.1
Headphones = 0.1
Shoulder = 0.1

[Face_Thresd]
face = 0.1

[Student_Thresd]
phone = 0.7
hand = 0.99
sleep = 0.5
stand = 0.99
read = 0.5

[Teacher_Behavior_Thresd]
MergeIoU = 0.8
SubjectClusterIoU = 0.45
# 当前固定Engine仅支持640；其他值启动时报错，原图分辨率仍可变化。
ImageSize = 640
sit = 0.4
stand = 0.4
bbwriting = 0.25
teach = 0.25
KeepOnlyMainSubject = true
MainSubjectStrategy = "posture_confidence"
PostureConflictRatio = 0.10
PostureConflictDefault = "stand"
ForcePostureWhenMissing = true


[ModelProtection]
# 模型静态加密开关。false 时按明文模型路径加载；true 时从 EncryptedModelRoot 解密 .enc 模型。
Enabled = false
# 加密模型目录。容器部署建议只读挂载到该路径。
EncryptedModelRoot = "/workspace/vbas/models-encrypted"
# 临时明文模型目录。建议使用内存盘，权限会设置为 0700。
DecryptedTempRoot = "/dev/shm/vbas-models"
# 旧secure entrypoint的运行期副本读取后删除；本轮直接启动/多worker需改为dev/shm之外的受控持久密钥路径。
KeyFile = "/dev/shm/vbas_model_key"
# 模型加载成功后是否删除临时明文文件。
CleanupAfterLoad = true
